{
  "name": "folder-shelf",
  "displayName": "%folderShelf.displayName%",
  "description": "%folderShelf.description%",
  "icon": "resources/icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "files": [
    "dist",
    "resources",
    "l10n",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.md",
    "README.en.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "folderShelf.openFile",
        "title": "%folderShelf.openFile.title%"
      },
      {
        "command": "folderShelf.addItem",
        "title": "%folderShelf.addItem.title%",
        "icon": "$(new-folder)"
      },
      {
        "command": "folderShelf.addCurrentProject",
        "title": "%folderShelf.addCurrentProject.title%",
        "icon": "$(save)"
      },
      {
        "command": "folderShelf.openFolder",
        "title": "%folderShelf.openFolder.title%",
        "icon": "$(open-in-product)"
      },
      {
        "command": "folderShelf.openConfigFile",
        "title": "%folderShelf.openConfigFile.title%",
        "icon": "$(json)"
      },
      {
        "command": "folderShelf.collapseAll",
        "title": "%folderShelf.collapseAll.title%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "folderShelf.refresh",
        "title": "%folderShelf.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "folderShelf.removeItem",
        "title": "%folderShelf.removeItem.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "folderShelf.openFile",
          "when": "false"
        },
        {
          "command": "folderShelf.openFolder",
          "when": "false"
        },
        {
          "command": "folderShelf.removeItem",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "folderShelf.addItem",
          "when": "view == folderShelf.views.folders",
          "group": "navigation"
        },
        {
          "command": "folderShelf.addCurrentProject",
          "when": "view == folderShelf.views.folders",
          "group": "navigation"
        },
        {
          "command": "folderShelf.openConfigFile",
          "when": "view == folderShelf.views.folders",
          "group": "navigation"
        },
        {
          "command": "folderShelf.collapseAll",
          "when": "view == folderShelf.views.folders",
          "group": "navigation"
        },
        {
          "command": "folderShelf.refresh",
          "when": "view == folderShelf.views.folders",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "folderShelf.openFolder",
          "when": "view == folderShelf.views.folders && viewItem == folders.folder",
          "group": "inline"
        },
        {
          "command": "folderShelf.removeItem",
          "when": "view == folderShelf.views.folders && (viewItem == folders.folder || viewItem == folders.file)",
          "group": "9_folderShelf"
        }
      ]
    },
    "configuration": [
      {
        "title": "%folderShelf.container.title%",
        "properties": {
          "folderShelf.configFile": {
            "type": "string",
            "default": "",
            "markdownDescription": "%folderShelf.configFile.description%",
            "scope": "application"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "folderShelf",
          "title": "%folderShelf.container.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "folderShelf": [
        {
          "type": "tree",
          "id": "folderShelf.views.folders",
          "name": "%folderShelf.container.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "watch:esbuild": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "l10n:extract": "vscode-l10n-dev export ./src --outDir ./l10n",
    "vscode:prepublish": "npm run check-types && npm run lint && npm run l10n:extract && node esbuild.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}