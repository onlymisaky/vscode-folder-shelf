{
  "name": "folder-shelf",
  "displayName": "%folderShelf.displayName%",
  "description": "%folderShelf.description%",
  "publisher": "onlymisaky",
  "icon": "resources/icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "files": [
    "dist",
    "resources",
    "l10n",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.md",
    "README.zh-cn.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "folderShelf.openFile",
        "title": "%folderShelf.openFile.title%"
      },
      {
        "command": "folderShelf.addItem",
        "title": "%folderShelf.addItem.title%",
        "icon": "$(new-folder)"
      },
      {
        "command": "folderShelf.addCurrentProject",
        "title": "%folderShelf.addCurrentProject.title%",
        "icon": "$(save)"
      },
      {
        "command": "folderShelf.openFolder",
        "title": "%folderShelf.openFolder.title%",
        "icon": "$(open-in-product)"
      },
      {
        "command": "folderShelf.openConfigFile",
        "title": "%folderShelf.openConfigFile.title%",
        "icon": "$(json)"
      },
      {
        "command": "folderShelf.collapseAll",
        "title": "%folderShelf.collapseAll.title%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "folderShelf.refresh",
        "title": "%folderShelf.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "folderShelf.removeItem",
        "title": "%folderShelf.removeItem.title%"
      },
      {
        "command": "folderShelf.showGrouped",
        "title": "%folderShelf.showGrouped.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "folderShelf.showTagged",
        "title": "%folderShelf.showTagged.title%",
        "icon": "$(tag)"
      },
      {
        "command": "folderShelf.showFlat",
        "title": "%folderShelf.showFlat.title%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "folderShelf.moveToGroup",
        "title": "%folderShelf.moveToGroup.title%"
      },
      {
        "command": "folderShelf.moveOutOfGroup",
        "title": "%folderShelf.moveOutOfGroup.title%"
      },
      {
        "command": "folderShelf.renameGroup",
        "title": "%folderShelf.renameGroup.title%"
      },
      {
        "command": "folderShelf.dissolveGroup",
        "title": "%folderShelf.dissolveGroup.title%"
      },
      {
        "command": "folderShelf.addTag",
        "title": "%folderShelf.addTag.title%"
      },
      {
        "command": "folderShelf.manageTags",
        "title": "%folderShelf.manageTags.title%"
      },
      {
        "command": "folderShelf.renameTag",
        "title": "%folderShelf.renameTag.title%"
      },
      {
        "command": "folderShelf.deleteTag",
        "title": "%folderShelf.deleteTag.title%"
      }
    ],
    "submenus": [
      {
        "id": "folderShelf.group",
        "label": "%folderShelf.submenu.group%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "folderShelf.openFile",
          "when": "false"
        },
        {
          "command": "folderShelf.openFolder",
          "when": "false"
        },
        {
          "command": "folderShelf.removeItem",
          "when": "false"
        },
        {
          "command": "folderShelf.showGrouped",
          "when": "folderShelf.taggedView"
        },
        {
          "command": "folderShelf.showTagged",
          "when": "folderShelf.flatView"
        },
        {
          "command": "folderShelf.showFlat",
          "when": "folderShelf.groupedView"
        },
        {
          "command": "folderShelf.moveToGroup",
          "when": "false"
        },
        {
          "command": "folderShelf.moveOutOfGroup",
          "when": "false"
        },
        {
          "command": "folderShelf.renameGroup",
          "when": "false"
        },
        {
          "command": "folderShelf.dissolveGroup",
          "when": "false"
        },
        {
          "command": "folderShelf.addTag",
          "when": "false"
        },
        {
          "command": "folderShelf.manageTags",
          "when": "false"
        },
        {
          "command": "folderShelf.renameTag",
          "when": "false"
        },
        {
          "command": "folderShelf.deleteTag",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "folderShelf.addItem",
          "when": "view == folderShelf.views.folders",
          "group": "navigation@1"
        },
        {
          "command": "folderShelf.addCurrentProject",
          "when": "view == folderShelf.views.folders",
          "group": "navigation@2"
        },
        {
          "command": "folderShelf.collapseAll",
          "when": "view == folderShelf.views.folders",
          "group": "navigation@3"
        },
        {
          "command": "folderShelf.showGrouped",
          "when": "view == folderShelf.views.folders && folderShelf.taggedView",
          "group": "navigation@4"
        },
        {
          "command": "folderShelf.showTagged",
          "when": "view == folderShelf.views.folders && folderShelf.flatView",
          "group": "navigation@4"
        },
        {
          "command": "folderShelf.showFlat",
          "when": "view == folderShelf.views.folders && folderShelf.groupedView",
          "group": "navigation@4"
        },
        {
          "command": "folderShelf.openConfigFile",
          "when": "view == folderShelf.views.folders",
          "group": "navigation@5"
        },
        {
          "command": "folderShelf.refresh",
          "when": "view == folderShelf.views.folders",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "folderShelf.openFolder",
          "when": "view == folderShelf.views.folders && viewItem =~ /^folders\\.folder/",
          "group": "inline"
        },
        {
          "command": "folderShelf.moveToGroup",
          "when": "view == folderShelf.views.folders && (viewItem =~ /^folders\\.(folder|file)(\\.tagged)?$/ || (folderShelf.selectionMixed && viewItem =~ /^folders\\.(folder|file)(\\.grouped)?(\\.tagged)?$/))",
          "group": "9_folderShelf@1"
        },
        {
          "submenu": "folderShelf.group",
          "when": "view == folderShelf.views.folders && viewItem =~ /^folders\\.(folder|file)\\.grouped(\\.tagged)?$/ && !folderShelf.selectionMixed",
          "group": "9_folderShelf@1"
        },
        {
          "command": "folderShelf.addTag",
          "when": "view == folderShelf.views.folders && viewItem =~ /^folders\\.(folder|file)(\\.grouped)?$/",
          "group": "9_folderShelf@2"
        },
        {
          "command": "folderShelf.manageTags",
          "when": "view == folderShelf.views.folders && viewItem =~ /^folders\\.(folder|file)(\\.grouped)?\\.tagged$/",
          "group": "9_folderShelf@2"
        },
        {
          "command": "folderShelf.removeItem",
          "when": "view == folderShelf.views.folders && viewItem =~ /^folders\\.(folder|file)/",
          "group": "9_folderShelf@3"
        },
        {
          "command": "folderShelf.renameGroup",
          "when": "view == folderShelf.views.folders && viewItem == folders.group",
          "group": "9_folderShelf@1"
        },
        {
          "command": "folderShelf.dissolveGroup",
          "when": "view == folderShelf.views.folders && viewItem == folders.group",
          "group": "9_folderShelf@2"
        },
        {
          "command": "folderShelf.renameTag",
          "when": "view == folderShelf.views.folders && viewItem == folders.tag",
          "group": "9_folderShelf@1"
        },
        {
          "command": "folderShelf.deleteTag",
          "when": "view == folderShelf.views.folders && viewItem == folders.tag",
          "group": "9_folderShelf@2"
        }
      ],
      "folderShelf.group": [
        {
          "command": "folderShelf.moveToGroup",
          "when": "view == folderShelf.views.folders && viewItem =~ /^folders\\.(folder|file)\\.grouped(\\.tagged)?$/",
          "group": "1_folderShelf@1"
        },
        {
          "command": "folderShelf.moveOutOfGroup",
          "when": "view == folderShelf.views.folders && viewItem =~ /^folders\\.(folder|file)\\.grouped(\\.tagged)?$/",
          "group": "1_folderShelf@2"
        }
      ]
    },
    "configuration": [
      {
        "title": "%folderShelf.container.title%",
        "properties": {
          "folderShelf.configFile": {
            "type": "string",
            "default": "",
            "markdownDescription": "%folderShelf.configFile.description%",
            "scope": "application"
          },
          "folderShelf.dragToTagAction": {
            "type": "string",
            "enum": [
              "alwaysAsk",
              "removeCurrent",
              "keepCurrent"
            ],
            "enumItemLabels": [
              "%folderShelf.dragToTagAction.alwaysAsk.label%",
              "%folderShelf.dragToTagAction.removeCurrent.label%",
              "%folderShelf.dragToTagAction.keepCurrent.label%"
            ],
            "enumDescriptions": [
              "%folderShelf.dragToTagAction.alwaysAsk.description%",
              "%folderShelf.dragToTagAction.removeCurrent.description%",
              "%folderShelf.dragToTagAction.keepCurrent.description%"
            ],
            "default": "alwaysAsk",
            "markdownDescription": "%folderShelf.dragToTagAction.description%"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "folderShelf",
          "title": "%folderShelf.container.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "folderShelf": [
        {
          "type": "tree",
          "id": "folderShelf.views.folders",
          "name": "%folderShelf.container.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "watch:esbuild": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "l10n:extract": "vscode-l10n-dev export ./src --outDir ./l10n",
    "vscode:prepublish": "npm run check-types && npm run lint && npm run l10n:extract && node esbuild.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
